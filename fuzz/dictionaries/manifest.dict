# Tokens for the manifest parser's fuzz target (RFC 006 rule 7; RFC 004 rules 23 to 26, 39).
# libFuzzer reads this with -dict=; ci/fuzz.sh passes it when a file of the target's name exists.
# The shapes a quantity can take: a number, an exponent, a fraction, a unit. The exponents are
# the ones that once made the parser build a text of the number's size.

# Units: time, bytes, and the domains' (the parser hands the latter to the domain unread)
"s"
"ms"
"us"
"ns"
"ps"
"fs"
"B"
"KiB"
"MiB"
"GiB"
"ohm"
"V"
"A"
"F"
"H"
"bit/s"
"Gbit/s"
"600y"

# Numbers and the points where a decimal changes shape
"0"
"1"
"0.5"
"1.5"
"340282366920938463463374607431768211455"
"340282366920938463463374607431768211456"
"0.000000000000000000000000000000000000001"
"000000000000000000000000000000000000000001"

# Exponents: signs, the bound (1000), the bound plus one, an i32's edge, and beyond it
"e"
"E"
"e+"
"e-"
"e3"
"e-3"
"e999"
"e1000"
"e1001"
"e-1000"
"e-1001"
"e2147483647"
"e2147483648"
"e2000000000"
"e-2000000000"
"e99999999999999999999"
"e-99999999999999999999"

# Whole quantities
"1e2000000000s"
"1e-2000000000s"
"1e1001s"
"0e2000000000s"
"5ms"
"1e-3s"
"4MiB"
"1e2000000000MiB"
"3eV"

# TOML around them
"[time]"
"tick = "
"end = "
"[limits.default]"
"memory = "
"[[connections]]"
"[connections.attrs]"
"delay = "
"loss = "
"[[changes]]"
"at = "
"[order]"
"[seed]"
"root = "
